# Copy to ~/.config/work-report/db.env (chmod 600).
# Read by the Quadlet unit work-report-db.container.
POSTGRES_DB=work_report
POSTGRES_USER=work_report
# Must match DB_PASSWORD in ~/.config/work-report/env
POSTGRES_PASSWORD=
# Local sockets trust (the container's own health check), network needs scram.
POSTGRES_INITDB_ARGS=--auth-local=trust --auth-host=scram-sha-256

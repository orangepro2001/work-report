# Copy to ~/.config/work-report/env (chmod 600) and fill in the secrets.
# Reference: docs/deploy.md

# --- application -----------------------------------------------------------
APP_KEY=
APP_URL=https://tony-ai-pc-1.tail9f7f1f.ts.net/report
WR_BASE_PATH=/report
WR_TZ=Asia/Seoul
APP_LOCALE=ko
WR_CURRENT_MEMBER="이성민"
WR_DEPARTMENT="검사 기술"

# --- database (PostgreSQL on the AI host, over the tailnet) ----------------
DB_CONNECTION=pgsql
DB_HOST=100.101.146.117
DB_PORT=5432
DB_DATABASE=work_report
DB_USERNAME=work_report
DB_PASSWORD=
DB_SSLMODE=require

# --- session / cache -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_PATH=/report
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Seed the reference workbook contents on boot (idempotent).
WR_SKIP_SEED=0

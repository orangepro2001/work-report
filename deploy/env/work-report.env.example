# Copy to ~/.config/work-report/env (chmod 600) and fill in the secrets.
# Reference: docs/deploy.md

# --- application -----------------------------------------------------------
APP_KEY=
APP_URL=https://tony-ai-pc-1.tail9f7f1f.ts.net/report
WR_BASE_PATH=/report
WR_TZ=Asia/Seoul
APP_LOCALE=ko

# SSO sign-in (docs/auth-seam.md). Both public hostnames are registered as
# redirect URIs on the SSO, so SSO_REDIRECT_URI stays empty and url() answers with
# whichever door the request came in on.
# Real-time document editing: shared with the Yjs service (signs room tokens).
COLLAB_SECRET=

SSO_ISSUER=https://521985.xyz/sso
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
# Server-to-server calls (token exchange, userinfo). The SSO runs on this host and
# the public address has no hairpin NAT, so these must not go to SSO_ISSUER.
SSO_INTERNAL_BASE=http://127.0.0.1:3550

WR_DEPARTMENT="검사 기술"

# --- database (PostgreSQL on this host, loopback) --------------------------
# The cluster is the local `work-report-db` Quadlet unit; DB_PASSWORD must equal
# POSTGRES_PASSWORD in db.env. The AI-host cluster is the rollback copy only —
# its commented block at the bottom of this file restores that behaviour.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=work_report
DB_USERNAME=work_report
DB_PASSWORD=
DB_SSLMODE=prefer

# --- session / cache -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_PATH=/report
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Seed the reference workbook contents on boot (idempotent).
WR_SKIP_SEED=0

# --- rollback: the pre-2026-11-05 AI-host cluster (never a default) --------
# Serves the board as it stood at the migration. Uncomment, replace the four
# DB_* lines above and restart the unit; the schema is identical.
# DB_HOST=100.101.146.117
# DB_PORT=5432
# DB_SSLMODE=require

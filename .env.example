APP_NAME="업무일보"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public origin: served through tailscale at /report. Keeping the prefix here makes
# the framework generate /report/... URLs without any asset() hackery.
APP_URL=http://127.0.0.1:3560

APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 on the AI host, reached over the tailnet (TLS required).
DB_CONNECTION=pgsql
DB_HOST=100.101.146.117
DB_PORT=5432
DB_DATABASE=work_report
DB_USERNAME=work_report
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
# The app is mounted under /report by the reverse proxy, so the cookie has to be
# scoped there or it will never be sent back.
SESSION_PATH=/report
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Reverse-proxy mount point. Empty for a root-mounted dev server.
WR_BASE_PATH=/report
WR_TZ=Asia/Seoul
# Free-text identity shown as "current member" until the SSO project provides a
# real actor (see docs/auth-seam.md).
WR_CURRENT_MEMBER="이성민"
WR_DEPARTMENT="검사 기술"
